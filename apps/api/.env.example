# Copy to .env and adjust. Never commit .env.
PORT=3001
NODE_ENV=development

# Matches docker-compose.yml defaults
DATABASE_URL="postgresql://reactive:reactive@localhost:5433/reactive_store?schema=public"

# Signs admin access tokens. At least 32 random characters; required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Admin cookies are Secure (HTTPS only) when NODE_ENV=production. Override with true/false.
COOKIE_SECURE=

# Origins allowed to send POST/PUT/PATCH/DELETE from a browser.
# WEB_ORIGIN is the store (checkout, enquiries); ADMIN_ORIGIN is the admin site,
# the only origin allowed on /api/auth and /api/admin.
# Production: https://yourstore.com and https://admin.yourstore.com
WEB_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3002

# Behind Caddy set to 1, so rate limits see the real client IP. Leave unset otherwise.
TRUST_PROXY=

# Order and enquiry submissions allowed per client IP every 10 minutes.
SUBMIT_RATE_LIMIT=5

# Telegram alerts for new orders and enquiries. Create a bot with @BotFather, put its
# token here, then run `npm run telegram:setup -w @reactive-store/api` to find chat ids.
# Several chats (people or a staff group) can be comma-separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Address of the admin site, for the "Open in dashboard" link in alerts,
# e.g. https://admin.yourstore.com. Leave empty to omit the link.
ADMIN_URL=

# Set to "off" to stop this process sending queued alerts (they stay in the database).
NOTIFICATIONS_WORKER=

# Store email alerts for new orders and enquiries. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Reactive Store <orders@example.com>"
ORDER_ALERT_TO=

# Product photo uploads are stored here (a persistent volume in production).
UPLOAD_DIR=uploads

# After an admin edit, the API asks the web app to refresh its cached catalogue.
# Use the same random REVALIDATE_SECRET in apps/web/.env.local.
WEB_INTERNAL_URL=http://localhost:3000
REVALIDATE_SECRET=
