# Copy to .env and adjust. Never commit .env.
PORT=3001
NODE_ENV=development

# Matches docker-compose.yml defaults
DATABASE_URL="postgresql://reactive:reactive@localhost:5433/reactive_store?schema=public"

# Origin of the web app (used for Origin checks on mutating requests)
WEB_ORIGIN=http://localhost:3000

# Behind Caddy set to 1, so rate limits see the real client IP. Leave unset otherwise.
TRUST_PROXY=

# Order and enquiry submissions allowed per client IP every 10 minutes.
SUBMIT_RATE_LIMIT=5

# Telegram alerts for new orders and enquiries. Create a bot with @BotFather, put its
# token here, then run `npm run telegram:setup -w @reactive-store/api` to find chat ids.
# Several chats (people or a staff group) can be comma-separated.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=

# Base URL of the admin panel, for the "Open in dashboard" link in alerts (Phase 3),
# e.g. https://yourstore.com/admin. Leave empty to omit the link.
ADMIN_URL=

# Set to "off" to stop this process sending queued alerts (they stay in the database).
NOTIFICATIONS_WORKER=

# Store email alerts for new orders and enquiries. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Reactive Store <orders@example.com>"
ORDER_ALERT_TO=
