# Copy to .env.local and adjust. Never commit .env.local.

# Where the Next.js server reaches the API (server-side only).
# In Docker this becomes http://api:3001
API_INTERNAL_URL=http://localhost:3001

# Shared with the API (same value as REVALIDATE_SECRET in apps/api/.env), so admin
# edits refresh the store at once.
REVALIDATE_SECRET=
